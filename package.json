{
  "name": "gongmoalarm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && ait build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "collect": "node --env-file-if-exists=.env collector/collect.ts",
    "test:collector": "node --test collector/parse.test.ts",
    "test:server": "node --test server/src/plan.test.ts",
    "dump": "node --env-file-if-exists=.env collector/dump.ts",
    "excerpts": "node --env-file-if-exists=.env collector/excerpts.ts",
    "check-overrides": "node collector/check-overrides.ts"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.8.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
